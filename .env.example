# ─── Supabase (auth + Postgres) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Qdrant (vector database, free tier) ────────────────────
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key

# ─── LLM: Groq (OpenAI-compatible, free tier — cheapest) ────
# Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here
# Optional overrides (defaults shown):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ─── Embeddings: Jina AI (free tier, no card — cheapest HTTP option) ──
# Get a free key at https://jina.ai/embeddings
EMBEDDINGS_API_KEY=your_jina_key_here
# Optional overrides (defaults shown). Any OpenAI-compatible embeddings
# endpoint works; keep EMBEDDING_DIM in sync with the model's output size.
# EMBEDDINGS_API_URL=https://api.jina.ai/v1/embeddings
# EMBEDDINGS_MODEL=jina-embeddings-v2-base-en
# EMBEDDING_DIM=768

# ─── aamarPay (payments, BDT) ───────────────────────────────
AAMARPAY_STORE_ID=your_store_id
AAMARPAY_SIGNATURE_KEY=your_signature_key
AAMARPAY_SANDBOX=true

# ─── Application ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated origins allowed to embed the chat widget cross-origin.
# Example: https://store1.com,https://shop.store2.com  (use * only for testing)
WIDGET_ALLOWED_ORIGINS=
