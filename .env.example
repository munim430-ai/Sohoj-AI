# ─────────────────────────────────────────────────────────────────────────────
# sohojAI — Backend / Admin environment (Next.js API + admin, SERVER-SIDE ONLY)
# Copy to `.env.local` and fill in. See ENVIRONMENT_VARIABLES.md for full detail.
# NEVER commit a filled-in copy. NEVER ship SECRET values to the Android app.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key        # SECRET — server only, never in APK
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_DB_URL=                                        # optional: migrations / RLS tests
SUPABASE_JWT_SECRET=                                    # optional

# AI provider (assistant EXPLAINS; all financial math is deterministic) ───────
AI_PROVIDER=mock                                        # mock | openai | groq | ppq
OPENAI_API_KEY=                                         # only if AI_PROVIDER=openai
GROQ_API_KEY=                                           # only if AI_PROVIDER=groq
PPQ_API_KEY=                                            # only if AI_PROVIDER=ppq
PPQ_BASE_URL=https://api.ppq.ai/v1                      # OpenAI-compatible endpoint
AI_MODEL=gpt-4o-mini
AI_MONTHLY_BUDGET_USD=15                                # server-side config (enforcement TODO)

# Device binding ──────────────────────────────────────────────────────────────
DEVICE_ID_HASH_SALT=                                    # SECRET — server-only salt for device-id hashing

# Payments (scaffold only — NO live gateway) ─────────────────────────────────
PAYMENT_PROVIDER=mock                                   # mock | sslcommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_SANDBOX=true

# Platform ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APK_UPDATE_MANIFEST_URL=
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=120

# ── LEGACY (POC web app) — slated for removal; kept so the current build runs ──
# Remove once the FAQ-RAG chatbot and aamarPay credit billing are deleted.
QDRANT_URL=
QDRANT_API_KEY=
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
AAMARPAY_SANDBOX=true
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000
