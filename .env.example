# ─── Supabase (auth + Postgres) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Qdrant (vector database, free tier) ────────────────────
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key

# ─── LLM: Groq (OpenAI-compatible, free tier — cheapest) ────
# Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here
# Optional overrides (defaults shown):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
#
# Embeddings run locally via all-MiniLM-L6-v2 (@huggingface/transformers).
# No key, no per-token cost.

# ─── aamarPay (payments, BDT) ───────────────────────────────
AAMARPAY_STORE_ID=your_store_id
AAMARPAY_SIGNATURE_KEY=your_signature_key
AAMARPAY_SANDBOX=true

# ─── Application ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated origins allowed to embed the chat widget cross-origin.
# Example: https://store1.com,https://shop.store2.com  (use * only for testing)
WIDGET_ALLOWED_ORIGINS=
