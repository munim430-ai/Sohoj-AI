# ─────────────────────────────────────────────────────────────────────────────
# sohojAI — LOCAL development overrides. Copy to `.env.local`.
# Defaults below run the whole backend with MOCK providers, so development is
# never blocked waiting on real Supabase / AI / payment credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Point at a local Supabase (`supabase start`) or a dev project.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local_anon_key
SUPABASE_SERVICE_ROLE_KEY=local_service_role_key       # SECRET — local only
SUPABASE_PROJECT_REF=local

# Mock everything external for offline dev.
AI_PROVIDER=mock
AI_MODEL=mock
AI_MONTHLY_BUDGET_USD=0

PAYMENT_PROVIDER=mock
SSLCOMMERZ_SANDBOX=true

NEXT_PUBLIC_APP_URL=http://localhost:3000
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=1000
