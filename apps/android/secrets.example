# ─────────────────────────────────────────────────────────────────────────────
# sohojAI Android app — build/runtime config.
# Copy to `apps/android/secrets.properties` (git-ignored). Gradle reads these.
#
# ⚠ ONLY publishable values belong here. The APK must NEVER contain:
#    - SUPABASE_SERVICE_ROLE_KEY
#    - any AI provider key (OPENAI/GROQ)
#    - any payment secret (SSLCommerz)
# All privileged actions go through the authenticated backend (API_BASE_URL).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (publishable — every access is RLS-guarded by org + device)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Backend (AI proxy, structured sync, payment session creation)
API_BASE_URL=http://10.0.2.2:3000        # 10.0.2.2 = host loopback from Android emulator

# Observability (optional — mock/disabled if blank)
SENTRY_DSN=

# Self-update manifest (optional)
APK_UPDATE_MANIFEST_URL=

# ── Release signing — put in apps/android/keystore.properties (LOCAL/CI ONLY) ──
# RELEASE_STORE_FILE=/absolute/path/to/release.keystore
# RELEASE_STORE_PASSWORD=
# RELEASE_KEY_ALIAS=sohojai
# RELEASE_KEY_PASSWORD=
# (Debug builds fall back to the standard Android debug keystore automatically.)
